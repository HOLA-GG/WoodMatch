rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous' && !exists(/databases/$(database)/documents/account_tombstones/$(request.auth.uid)) && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || !('deleting' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deleting != true); }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function admin() { return signedIn() && request.auth.token.admin == true; }
  match /users/{uid} {
   allow read: if owner(uid) || admin();
   allow create: if owner(uid) && request.resource.data.uid == uid
    && request.resource.data.keys().hasOnly(['uid','name','email','phone','dob','city','gender','role','sectorSuba','privacyVersion','privacyAcceptedAt'])
    && request.resource.data.role in ['GENERADOR','RECEPTOR','MIXTO']
    && request.resource.data.privacyVersion == '2026-10-22-prototipo'
    && request.resource.data.privacyAcceptedAt == request.time;
   allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','city','sectorSuba']);
   allow delete: if false; // Server-controlled erasure workflow.
  }
  match /wood_wastes/{wasteId} {
   allow read: if signedIn() && resource.data.schemaVersion == 2;
   allow create: if owner(request.resource.data.authorId)
    && request.resource.data.keys().hasOnly(['id','schemaVersion','title','description','wasteType','materialState','category','quantityValue','quantityUnit','volumeM3','quantityEstimated','subaSector','exactLatitude','exactLongitude','referenceAddress','speciesName','speciesConfidence','suggestedUses','isAiAssisted','status','authorId','authorName','authorPhone','createdAt','updatedAt','reservedBy','reservedByName','completedAt','completedBy','imageUri','typedStatus','typedCategory','available','reserved','completed','formattedQuantity'])
    && request.resource.data.id == wasteId && request.resource.data.schemaVersion == 2
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['GENERADOR','MIXTO']
    && request.resource.data.status == 'DISPONIBLE'
    && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
    && request.resource.data.description is string && request.resource.data.description.size() <= 3000
    && request.resource.data.quantityValue is number && request.resource.data.quantityValue > 0 && request.resource.data.quantityValue <= 1000000
    && request.resource.data.authorPhone == '' && request.resource.data.referenceAddress == ''
    && request.resource.data.reservedBy == null && request.resource.data.completedAt == null;
   allow update: if owner(resource.data.authorId) && resource.data.status == 'DISPONIBLE'
    && request.resource.data.status == 'INACTIVO'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
   allow delete: if false;
  }
  match /withdrawal_requests/{id} {
   allow read: if owner(resource.data.authorId) || owner(resource.data.requesterId);
   allow write: if false; // Callable functions enforce transitions atomically.
   match /events/{eventId} { allow read, write: if false; }
  }
  match /withdrawal_passes/{id} { allow read, write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
