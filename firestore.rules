rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() {
   return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
    && !exists(/databases/$(database)/documents/account_tombstones/$(request.auth.uid))
    && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
       || !('deleting' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
       || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deleting != true);
  }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function admin() { return signedIn() && request.auth.token.admin == true; }
  match /users/{uid} {
   allow read: if owner(uid) || admin();
   allow create: if owner(uid) && request.resource.data.uid == uid
    && request.resource.data.keys().hasOnly(['uid','name','email','phone','dob','city','gender','role','sectorSuba','privacyVersion','privacyAcceptedAt'])
    && request.resource.data.role in ['GENERADOR','RECEPTOR','MIXTO']
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
    && request.resource.data.privacyVersion == '2026-PILOTO-2'
    && request.resource.data.privacyAcceptedAt == request.time;
   allow update: if owner(uid)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','city','sectorSuba','role','updatedAt'])
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
    && (request.resource.data.role in ['GENERADOR','RECEPTOR','MIXTO'] || request.resource.data.role == resource.data.role)
    && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  match /wood_wastes/{id} {
   allow read: if signedIn() && (
    (resource.data.schemaVersion in [2,3] && resource.data.status in ['HALLAZGO','DISPONIBLE','RESERVADO'])
    || resource.data.authorId == request.auth.uid || resource.data.completedBy == request.auth.uid);
   // All mutations are authorized and validated in the Edge Function; the Admin REST adapter bypasses rules.
   allow write: if false;
   match /events/{eventId} {
    allow read: if owner(get(/databases/$(database)/documents/wood_wastes/$(id)).data.authorId);
    allow write: if false;
   }
  }
  match /withdrawal_requests/{id} {
   allow read: if owner(resource.data.authorId) || owner(resource.data.requesterId);
   allow write: if false;
   match /events/{eventId} {
    allow read: if owner(get(/databases/$(database)/documents/withdrawal_requests/$(id)).data.authorId)
     || owner(get(/databases/$(database)/documents/withdrawal_requests/$(id)).data.requesterId);
    allow write: if false;
   }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
