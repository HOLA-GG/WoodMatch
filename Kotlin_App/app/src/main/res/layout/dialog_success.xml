<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Animated Checkmark or Logo -->
        <ImageView
            android:id="@+id/dialogSuccessIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/iconoapp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/dialogSuccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Éxito!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/dialogSuccessMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Operación completada con éxito."
            android:textSize="16sp"
            android:textAlignment="center"
            android:textColor="#444444"/>

        <!-- Progress Spinner for visual delay effect -->
        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="?attr/colorPrimary"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
